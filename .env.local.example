# Resend — contact form email delivery
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# Giscus — GitHub Discussions comments on blog posts
# Generate at https://giscus.app (repo: davideimola/davideimola.dev)
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Cloudflare Turnstile — anti-spam on contact form
# Generate at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami Cloud — privacy-friendly web analytics (cookieless, proxied via /relay)
# Website ID from https://cloud.umami.is → Settings → Websites → Edit.
# When empty, no analytics script is rendered.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# newsletter-svc: the newsletter's subscribers and sends, on Davide's own server (ADR-0006)
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_; the key must never reach the client
# bundle. Used by the subscribe server action and by `pnpm newsletter:draft`.
NEWSLETTER_API_URL=https://news.davideimola.dev
# The service's API_KEY: in ~/.config/newsletter-cloud-setup.env, written by the cluster
# repo's scripts/setup-newsletter.sh.
NEWSLETTER_API_KEY=

# tsundoku: the personal library that feeds the /shelf page
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_; the token must never reach the
# client bundle. Origin of the tsundoku instance (the page appends /api/showcase),
# plus the read-only API bearer token (tsundoku's API_BEARER_TOKEN, distinct from its
# MCP token). When either is empty, /shelf renders the committed snapshot in
# src/content/shelf.fallback.json instead of failing.
# The same two variables are what `pnpm shelf:snapshot` reads to refresh that
# snapshot from the live library. Refreshing it is a deliberate act run by hand and
# committed: no build, deploy or revalidation ever writes the file.
TSUNDOKU_API_URL=
TSUNDOKU_BEARER_TOKEN=
